rules_version = '2';

// All app data lives under users/{uid}/ (notes, tasks, task_lists,
// calendar_events, labels, shared_*_prefs, fcm_tokens, settings, crypto).
// Each signed-in user has full access to their own branch, except that,
// once they have encryption keys (users/{uid}/crypto/keys), the end-to-end
// encrypted collections accept only encrypted documents (`e` = 1 and an
// `enc` blob, see guides/E2EE_PLAN.md). Users without keys (encryption
// off, or skipped) keep writing in clear. On top of that:
// - user_directory maps an email to a uid, so items can be shared by email;
// - public_keys holds each user's encryption public key;
// - a note, task or event can be shared: its collaborators (uids in
//   `collaborators`) may read it, edit its shared content and remove
//   themselves from it.
// Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCollaborator() {
      return signedIn() && request.auth.uid in resource.data.collaborators;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The collaborator only removes themselves from the item.
    function leaves() {
      return changedKeys().hasOnly(['collaborators', 'collaboratorProfiles'])
        && request.resource.data.collaborators
          == resource.data.collaborators.removeAll([request.auth.uid])
        && !(request.auth.uid in request.resource.data.collaboratorProfiles)
        && request.resource.data.collaboratorProfiles.keys().toSet()
          == resource.data.collaboratorProfiles.keys().toSet()
            .difference([request.auth.uid].toSet());
    }

    // A collaborator may change only the shared content of an item
    // (personal fields live in their own shared_*_prefs) or leave it.
    // Encrypted item: only `enc` and `updatedAt`, never `keys`, `keyVer`,
    // `priv` or the members (the client also sends the `keyVer` it
    // encrypted for, which counts as a change, and is refused, if the owner
    // replaced the key). Item in clear (owner without keys): the
    // [plainKeys], which mirror `sharedKeys` of NoteModel, TaskModel and
    // CalendarEventModel.
    function collaboratorUpdate(plainKeys) {
      return isCollaborator()
        && ((resource.data.get('e', 0) == 1
            && changedKeys().hasOnly(['enc', 'updatedAt']))
          || (resource.data.get('e', 0) != 1
            && changedKeys().hasOnly(plainKeys))
          || leaves());
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Collections whose documents are end-to-end encrypted.
    function encryptedCollections() {
      return ['notes', 'tasks', 'calendar_events', 'labels', 'task_lists',
        'shared_note_prefs', 'shared_task_prefs', 'shared_event_prefs'];
    }

    // The document as it will be is encrypted.
    function staysEncrypted() {
      return request.resource.data.get('e', 0) == 1
        && request.resource.data.get('enc', null) is map;
    }

    // The user has encryption keys: from then on nothing in clear can be
    // written in their encrypted collections, not even by them. One extra
    // read, made only for writes in clear (staysEncrypted() comes first).
    function hasKeys(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/crypto/keys);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!(collection in encryptedCollections())
          || staysEncrypted()
          || !hasKeys(uid));
    }

    // One entry per user, keyed by their lowercase email. Readable one at a
    // time by its exact email (no listing, so emails can't be enumerated),
    // written only by the user it describes.
    match /user_directory/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // End-to-end encryption: each user's X25519 public key, so others can
    // seal item keys for them when sharing. Readable one at a time by any
    // signed-in user, written only by its owner. The private keys stay in
    // users/{uid}/crypto/keys, wrapped (covered by the rule above).
    match /public_keys/{uid} {
      allow get: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Shared items, for collaborators (the owner is covered above). Also
    // match the collection-group queries on `collaborators`.
    match /{path=**}/notes/{noteId} {
      allow read: if isCollaborator();
      allow update: if collaboratorUpdate([
        'title', 'content', 'type', 'style', 'checklistItems', 'updatedAt'
      ]);
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isCollaborator();
      allow update: if collaboratorUpdate([
        'title', 'description', 'isCompleted', 'dueDate', 'recurrence',
        'recurrenceExceptions', 'subtasks', 'updatedAt'
      ]);
    }

    match /{path=**}/calendar_events/{eventId} {
      allow read: if isCollaborator();
      allow update: if collaboratorUpdate([
        'title', 'description', 'location', 'color', 'startTime', 'endTime',
        'isAllDay', 'isBirthday', 'isNameDay', 'recurrence',
        'recurrenceEndDate', 'recurrenceInterval', 'recurrenceWeekdays',
        'recurrenceMonthWeek', 'recurrenceExceptions', 'updatedAt'
      ]);
    }
  }
}
