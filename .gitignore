android/.kotlin/

# Local release build and deploy scripts
deploy_android.ps1
deploy_web.ps1

# Firebase CLI cache (Hosting deploy hashes)
.firebase/

# Local AI assistant context (not shared with the team)
CLAUDE.md
TASKS.md

# Generic guides shared across my apps (kept locally)
/guides/

# Raw device screenshots (sources for tool/preview, kept locally)
images/screenshots/*_raw.png

# Local helper scripts and tooling
/tool/
# Dart debug symbols from obfuscated release builds (deploy_android.ps1)
/symbols/

# Personal Google Takeout exports (never commit)
Takeout/
taskenda_backup_*.json
